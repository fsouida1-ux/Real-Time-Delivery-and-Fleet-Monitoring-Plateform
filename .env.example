# --- PostgreSQL ---
POSTGRES_DB=delivery
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

POSTGRES_HOST=127.0.0.1

# --- Kafka (mode KRaft, sans Zookeeper) ---

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_PORT=9092

# --- Kafbat UI (observation des topics Kafka) ---
KAFBAT_PORT=8080

# --- Metabase (dashboard BI) ---
METABASE_PORT=3000

# --- Règles métier (utilisées par les services Python) ---
GPS_SPEED_THRESHOLD_KMH=120
DRIVER_INACTIVE_MINUTES=5
DELIVERY_DELAY_MINUTES=45
METRICS_INTERVAL_SECONDS=30